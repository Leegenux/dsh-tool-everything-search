{
  "name": "@deepseek-ai/dsh-tool-everything-search",
  "description": "Read-only Everything-backed filename search for Windows-wide queries",
  "version": "0.1.0",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/fs/tool-everything-search"
  },
  "type": "module",
  "main": "lib/index.mjs",
